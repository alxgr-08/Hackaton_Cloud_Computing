# ─────────────────────────────────────────────────────────────
#  Configuración del frontend — copia este archivo a `.env`
# ─────────────────────────────────────────────────────────────

# URL de invocación del endpoint POST de Amazon API Gateway.
# La proporciona el Arquitecto de Ingesta (rol 2). Ejemplo:
# https://abc123.execute-api.us-east-1.amazonaws.com/prod/evaluar
VITE_API_URL=

# Modo demo: "true" simula todo localmente sin AWS ni Firestore.
# Déjalo en "false" (o vacío) para usar la nube real.
# Si VITE_API_URL está vacío, el modo demo se activa automáticamente.
VITE_USE_MOCK=true

# ── Firebase (Firestore en tiempo real + Hosting) ──
# Estos valores salen de la consola de Firebase:
# Configuración del proyecto → Tus apps → SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
