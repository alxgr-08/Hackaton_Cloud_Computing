# Nunca subas el archivo .env real. Reemplaza únicamente los valores de ejemplo.
# Proveedor activo en producción: OpenAI.
LLM_PROVIDER=openai
OPENAI_API_KEY=pega_tu_clave_de_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Alternativa compatible (solo si LLM_PROVIDER=groq).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"tu-proyecto","private_key":"-----BEGIN PRIVATE KEY-----\\nREEMPLAZAR\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com"}
FIRESTORE_COLLECTION=evaluaciones

# ARN de la cola SQS que dispara esta Lambda (la administra el rol de ingesta).
SQS_QUEUE_ARN=arn:aws:sqs:us-east-1:TU_CUENTA_AWS:becas-ingesta-queue

# Rol de ejecución de la Lambda. En AWS Academy es el "LabRole" de la cuenta.
LAMBDA_ROLE_ARN=arn:aws:iam::TU_CUENTA_AWS:role/LabRole
