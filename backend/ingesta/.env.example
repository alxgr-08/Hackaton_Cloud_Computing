# Variable de entorno de la Lambda de ingesta.
# Se configura en la consola de Lambda (Configuración, Variables de entorno)
# o en la herramienta de despliegue. No se sube el valor real al repositorio.

# URL de la cola SQS donde la ingesta publica un mensaje por postulante.
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/TU_CUENTA_AWS/becas-ingesta-queue
